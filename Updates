                });
                
                shareText += `🌿 Species:\n`;
                Object.entries(speciesCount).slice(0, 3).forEach(([species, count]) => {
                    const shortName = species.split(' ').slice(0, 2).join(' ');
                    shareText += `   • ${shortName}: ${count}\n`;
                });
                
                if (Object.keys(speciesCount).length > 3) {
                    shareText += `   • ... and ${Object.keys(speciesCount).length - 3} more\n`;
                }
            }
            
            shareText += `\n🔗 ${window.location.href}`;
            
            await navigator.share({
                title: 'Future Seeds Program Data',
                text: shareText,
                url: window.location.href,
            });
            
            document.getElementById('outputBox').innerText = '✅ Data shared successfully!';
            
        } catch (err) {
            if (err.name !== 'AbortError') {
                console.error('Share failed:', err);
                document.getElementById('outputBox').innerText = '❌ Sharing failed: ' + err.message;
            }
        }
    }
    
    async function shareSingleRecord(id) {
        const record = savedRecords.find(r => r.id == id);
        if (!record) return;
        
        if (!navigator.share) {
            const summary = 
                `🌱 Future Seeds Record\n` +
                `📅 Date: ${record.collectionDate}\n` +
                `👤 Observer: ${record.observer}\n` +
                `🌿 Species: ${record.species}\n` +
                `📍 Location: ${record.location?.region || 'Unknown'}\n` +
                `🔗 ${window.location.href}`;
            
            try {
                await navigator.clipboard.writeText(summary);
                alert('📋 Record summary copied to clipboard!');
            } catch (clipboardError) {
                const textarea = document.createElement('textarea');
                textarea.value = summary;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                alert('📋 Record summary copied to clipboard!');
            }
            return;
        }
        
        try {
            const floweringStages = Object.entries(record.phenology?.flowering || {})
                .filter(([key, value]) => value && key !== 'none')
                .map(([key]) => key)
                .join(', ') || 'None';
            
            const pollinatorTypes = Object.entries(record.phenology?.pollinators || {})
                .filter(([key, value]) => value && key !== 'other' && key !== 'none')
                .map(([key]) => key)
                .join(', ') || 'None';
            
            const shareText = 
                `🌱 Future Seeds Record\n` +
                `📅 Date: ${record.collectionDate}\n` +
                `👤 Observer: ${record.observer}\n` +
                `🌿 Species: ${record.species}\n` +
                `📍 Location: ${record.location?.region || 'Unknown'}\n` +
                `📍 Coordinates: ${record.location?.latitude}, ${record.location?.longitude}\n` +
                `🌼 Flowering: ${floweringStages}\n` +
                `🐝 Pollinators: ${pollinatorTypes}\n` +
                (record.weather?.minTemp ? `🌡️ Temp: ${record.weather.minTemp}°C - ${record.weather.maxTemp}°C\n` : '') +
                `\n🔗 ${window.location.href}`;
            
            await navigator.share({
                title: `Future Seeds: ${record.species}`,
                text: shareText,
                url: window.location.href,
            });
            
        } catch (err) {
            if (err.name !== 'AbortError') {
                console.error('Share failed:', err);
                alert('Sharing failed: ' + err.message);
            }
        }
    }

