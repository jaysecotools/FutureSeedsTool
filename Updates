function saveRecord() {
    const observer = document.getElementById('observer').value.trim();
    if (observer) localStorage.setItem(CONFIG.OBSERVER_KEY, observer);
    
    if (!validateForm()) return;
    
    const record = collectFormData();
    
    // Estimate storage
    const estimatedSize = new Blob([JSON.stringify(record)]).size;
    const currentUsage = updateStorageMeter();
    const projected = currentUsage + (estimatedSize / (1024 * 1024));
    
    if (projected > CONFIG.STORAGE_LIMIT_MB) {
        if (!confirm(`⚠️ This may exceed storage limit (${projected.toFixed(2)} MB). Continue?`)) {
            return;
        }
    }
    
    savedRecords.push(record);
    localStorage.setItem(CONFIG.STORAGE_KEY, JSON.stringify(savedRecords));
    
    displayRecords();
    updateStats();
    updateStorageMeter();
    
    document.getElementById('outputBox').innerText = 
        `✅ Record saved!\n` +
        `🌿 ${record.species}\n` +
        `📍 ${record.location.region}\n` +
        `📅 ${record.collectionDate}\n` +
        `⭐ Confidence: ${record.confidence || '?'}/3\n` +
        `Total records: ${savedRecords.length}`;
    
    resetForm();
}

// ========== CSV GENERATION & EXPORT ==========
function generateCSVString(records) {
    if (records.length === 0) return '';
    
    const headers = [
        'ID', 'Timestamp', 'Observer', 'Collection Date', 'Species',
        'Region', 'Latitude', 'Longitude', 'Site Name',
        'Bud', 'Early Flower', 'Full Flower', 'Petal Fall', 'Seed Pod', 'Flowering None',
        'Honeybee', 'Native Bee', 'Fly', 'Beetle', 'Wasp', 'Butterfly', 'Birds', 'Other Pollinators', 'Pollinators None',
        'Plants Assessed', 'Survey Duration (min)', 'Flower Abundance (1-5)', 'Pollinator Abundance (1-5)', 'Seed Maturity',
        'Canopy Cover', 'Soil Moisture', 'Recent Rainfall', 'Disturbance', 'Fire History',
        'Min Temp (°C)', 'Max Temp (°C)', 'Weather Source',
        'Confidence (1-3)', 'Notes'
    ];
    
    const rows = records.map(r => [
        r.id, r.timestamp, r.observer, r.collectionDate, r.species,
        r.location.region, r.location.latitude, r.location.longitude, r.location.siteName || '',
        r.phenology.flowering.bud, r.phenology.flowering.earlyFlower, r.phenology.flowering.fullFlower,
        r.phenology.flowering.petalFall, r.phenology.flowering.seedPod, r.phenology.flowering.none,
        r.phenology.pollinators.honeybee, r.phenology.pollinators.nativeBee, r.phenology.pollinators.fly,
        r.phenology.pollinators.beetle, r.phenology.pollinators.wasp, r.phenology.pollinators.butterfly,
        r.phenology.pollinators.birds, r.phenology.pollinators.other || '', r.phenology.pollinators.none,
        r.phenology.plantsAssessed || '', r.phenology.surveyDuration || '', r.phenology.flowerAbundance || '',
        r.phenology.pollinatorAbundance || '', r.phenology.seedMaturity || '',
        r.habitat.canopyCover || '', r.habitat.soilMoisture || '', r.habitat.recentRainfall || '',
        r.habitat.disturbance || '', r.habitat.fireHistory || '',
        r.weather.minTemp || '', r.weather.maxTemp || '', r.weather.source || '',
        r.confidence || '', r.habitat.notes || ''
    ]);
    
    const escapeCSV = (cell) => {
        const str = String(cell);
        if (str.includes(',') || str.includes('"') || str.includes('\n')) {
            return `"${str.replace(/"/g, '""')}"`;
        }
        return str;
    };
    
    return [headers.join(','), ...rows.map(row => row.map(escapeCSV).join(','))].join('\n');
}

function downloadCSV(csvString, prefix) {
    const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `future_seeds_${prefix}_${new Date().toISOString().split('T')[0]}.csv`;
    a.click();
    URL.revokeObjectURL(url);
}

function exportAllCSV() {
    if (savedRecords.length === 0) {
        alert('No records to export');
        return;
    }
    const csv = generateCSVString(savedRecords);
    downloadCSV(csv, 'all_records');
}

function exportSelectedCSV() {
    if (selectedRecordIds.size === 0) {
        alert('Select records using checkboxes first');
        return;
    }
    const selected = savedRecords.filter(r => selectedRecordIds.has(r.id.toString()));
    const csv = generateCSVString(selected);
    downloadCSV(csv, 'selected_records');
    document.getElementById('outputBox').innerText = `✅ Exported ${selected.length} selected record(s)`;
}

function emailCSV() {
    if (savedRecords.length === 0) {
        alert('No records to email');
        return;
    }
    const csv = generateCSVString(savedRecords);
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = URL.createObjectURL(blob);
    const subject = encodeURIComponent('Future Seeds Program Data Export');
    const body = encodeURIComponent(`Future Seeds Data Export\nTotal Records: ${savedRecords.length}\nDate: ${new Date().toLocaleDateString()}\n\nCSV data available at: ${url}`);
    window.location.href = `mailto:?subject=${subject}&body=${body}`;
    setTimeout(() => URL.revokeObjectURL(url), 10000);
}

// ========== RECORD DISPLAY & MANAGEMENT ==========
function displayRecords() {
    const grid = document.getElementById('recordsGrid');
    const countEl = document.getElementById('recordCount');
    
    if (!savedRecords.length) {
        grid.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:2rem;">No saved records yet. Complete and save your first observation!</div>';
        countEl.innerText = '0 records';
        selectedRecordIds.clear();
        return;
    }
    
    countEl.innerText = `${savedRecords.length} record${savedRecords.length !== 1 ? 's' : ''}`;
    const sorted = [...savedRecords].reverse();
    
    grid.innerHTML = sorted.map(record => `
        <div class="record-card" data-id="${record.id}">
            <input type="checkbox" class="record-select" ${selectedRecordIds.has(record.id.toString()) ? 'checked' : ''} 
                   onclick="event.stopPropagation(); window.toggleRecordSelection('${record.id}', this.checked)">
            <div class="record-date">📅 ${record.collectionDate}</div>
            <div class="record-species">🌿 ${record.species.split(' ').slice(0, 2).join(' ')}</div>
            <div class="record-location">📍 ${record.location.region}</div>
            <div>🌡️ ${record.weather.minTemp || '?'}/${record.weather.maxTemp || '?'}°C</div>
            <div>⭐ ${record.confidence || '?'}/3 · 🌸 ${record.phenology.flowerAbundance || '?'}/5</div>
            <div class="record-actions">
