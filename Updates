window.toggleRecordSelection = function(id, checked) {
    if (checked) {
        selectedRecordIds.add(id.toString());
    } else {
        selectedRecordIds.delete(id.toString());
    }
    document.getElementById('outputBox').innerText = `${selectedRecordIds.size} record(s) selected for export`;
};

window.editRecord = function(id) {
    const record = savedRecords.find(r => r.id == id);
    if (!record) return;
    
    alert('Edit mode: Please delete the old record and save a new one with your changes.');
    // For simplicity in this version, we just select it in output
    document.getElementById('outputBox').innerText = JSON.stringify(record, null, 2);
};

window.deleteRecord = function(id) {
    if (!confirm('Delete this record?')) return;
    savedRecords = savedRecords.filter(r => r.id != id);
    selectedRecordIds.delete(id.toString());
    localStorage.setItem(CONFIG.STORAGE_KEY, JSON.stringify(savedRecords));
    displayRecords();
    updateStats();
    updateStorageMeter();
    document.getElementById('outputBox').innerText = '🗑️ Record deleted.';
};

function clearAllRecords() {
    if (confirm('Delete ALL saved records? This cannot be undone.')) {
        savedRecords = [];
        selectedRecordIds.clear();
        localStorage.removeItem(CONFIG.STORAGE_KEY);
        displayRecords();
        updateStats();
        updateStorageMeter();
        document.getElementById('outputBox').innerText = '🗑️ All records cleared.';
    }
}

// ========== IMPORT CSV ==========
function importCSV(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const text = e.target.result;
            const lines = text.split('\n');
            if (lines.length < 2) throw new Error('Invalid CSV');
            
            let imported = 0;
            for (let i = 1; i < lines.length; i++) {
                if (!lines[i].trim()) continue;
                const values = lines[i].split(',').map(v => v.replace(/^"|"$/g, ''));
                if (values.length >= 5) {
                    const record = {
                        id: Date.now() + i + Math.random(),
                        timestamp: new Date().toISOString(),
                        observer: values[2] || '',
                        collectionDate: values[3] || '',
                        species: values[4] || 'Unknown',
                        location: {
                            region: values[5] || 'Imported',
                            latitude: parseFloat(values[6]) || -42.88,
                            longitude: parseFloat(values[7]) || 147.33
                        },
                        phenology: { flowering: {}, pollinators: {} },
                        habitat: {},
                        weather: { minTemp: parseFloat(values[31]) || null, maxTemp: parseFloat(values[32]) || null },
                        confidence: values[34] || null
                    };
                    savedRecords.push(record);
                    imported++;
                }
            }
            
            if (imported > 0) {
                localStorage.setItem(CONFIG.STORAGE_KEY, JSON.stringify(savedRecords));
                displayRecords();
                updateStats();
                updateStorageMeter();
                document.getElementById('outputBox').innerText = `✅ Imported ${imported} records from CSV`;
            } else {
                alert('No valid records found');
            }
        } catch (error) {
            alert('Error importing CSV: ' + error.message);
        }
    };
    reader.readAsText(file);
}

