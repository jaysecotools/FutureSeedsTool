// ========== CHECKBOX LOGIC ==========
function setupCheckboxLogic() {
    // Flowering "None" clears others
    document.getElementById('floweringNone').addEventListener('change', function() {
        if (this.checked) {
            ['bud', 'earlyFlower', 'fullFlower', 'petalFall', 'seedPod'].forEach(id => {
                document.getElementById(id).checked = false;
            });
        }
    });
    
    // Pollinators "None" clears others
    document.getElementById('pollinatorsNone').addEventListener('change', function() {
        if (this.checked) {
            ['honeybee', 'nativeBee', 'fly', 'beetle', 'wasp', 'butterfly', 'birds'].forEach(id => {
                document.getElementById(id).checked = false;
            });
            document.getElementById('otherPollinators').value = '';
        }
    });
    
    // Individual flowering checkboxes uncheck "None"
    ['bud', 'earlyFlower', 'fullFlower', 'petalFall', 'seedPod'].forEach(id => {
        document.getElementById(id).addEventListener('change', function() {
            if (this.checked) document.getElementById('floweringNone').checked = false;
        });
    });
    
    // Individual pollinator checkboxes uncheck "None"
    ['honeybee', 'nativeBee', 'fly', 'beetle', 'wasp', 'butterfly', 'birds'].forEach(id => {
        document.getElementById(id).addEventListener('change', function() {
            if (this.checked) document.getElementById('pollinatorsNone').checked = false;
        });
    });
    
    document.getElementById('otherPollinators').addEventListener('input', function() {
        if (this.value.trim()) document.getElementById('pollinatorsNone').checked = false;
    });
}

// ========== INITIALIZATION ==========
function init() {
    // Load saved data
    savedRecords = JSON.parse(localStorage.getItem(CONFIG.STORAGE_KEY)) || [];
    const savedObserver = localStorage.getItem(CONFIG.OBSERVER_KEY) || '';
    
    // Initialize UI components
    initSpeciesSelector();
    initMap();
    setupStarRating();
    setupPhotoInput();
    setupCheckboxLogic();
    
    // Set today's date
    const today = new Date();
    const year = today.getFullYear();
    const month = String(today.getMonth() + 1).padStart(2, '0');
    const day = String(today.getDate()).padStart(2, '0');
    document.getElementById('obsDate').value = `${year}-${month}-${day}`;
    
    if (savedObserver) document.getElementById('observer').value = savedObserver;
    
    // Display saved records
    displayRecords();
    updateStats();
    updateStorageMeter();
    updateMonthDisplay();
    updateTempDisplay();
    updateSpeciesInfo();
    
    // Set initial location
    enableQuickRegionMode();
    
    // Welcome message
    if (savedRecords.length > 0) {
        document.getElementById('outputBox').innerText = `🌿 Welcome back! You have ${savedRecords.length} saved record(s).`;
    }
}

// ========== EVENT LISTENERS ==========
document.addEventListener('DOMContentLoaded', () => {
    init();
    
    // Guide toggle
    document.getElementById('guideToggleBtn').addEventListener('click', () => {
        document.getElementById('guidePanel').classList.toggle('show');
    });
    
    // Location mode
    document.getElementById('toggleLocationMode').addEventListener('click', () => {
        if (usingMapMode) enableQuickRegionMode();
        else enableMapMode();
    });
    
    // Map controls
    document.getElementById('myLocationBtn').addEventListener('click', getUserLocation);
    document.getElementById('showMapBtn').addEventListener('click', () => toggleMap(true));
    document.getElementById('hideMapBtn').addEventListener('click', () => toggleMap(false));
    
    // Weather
    document.getElementById('autoWeatherBtn').addEventListener('click', () => loadCurrentWeather(true));
    
    // Form actions
    document.getElementById('saveRecordBtn').addEventListener('click', saveRecord);
    document.getElementById('resetBtn').addEventListener('click', resetForm);
    document.getElementById('exportAllBtn').addEventListener('click', exportAllCSV);
    document.getElementById('exportSelectedBtn').addEventListener('click', exportSelectedCSV);
    document.getElementById('emailCsvBtn').addEventListener('click', emailCSV);
    document.getElementById('clearAllBtn').addEventListener('click', clearAllRecords);
    
    // Region change
    document.getElementById('regionSelect').addEventListener('change', updateFromRegion);
    
    // Date change
    document.getElementById('obsDate').addEventListener('change', updateMonthDisplay);
    
    // Temp inputs
    document.getElementById('actualMinTemp').addEventListener('input', updateTempDisplay);
    document.getElementById('actualMaxTemp').addEventListener('input', updateTempDisplay);
    
    // CSV Import
    document.getElementById('importFile').addEventListener('change', (e) => {
        if (e.target.files.length) importCSV(e.target.files[0]);
    });
});

