<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Future Seeds Program · Tasmania Phenology Hub v5.0</title>
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: linear-gradient(145deg, #123d24, #1a4f2e);
            padding: 2rem 1rem;
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
        }
        .card {
            max-width: 1600px;
            margin: 0 auto;
            background: #fefae6;
            border-radius: 48px;
            box-shadow: 0 30px 45px -15px #0b2a18;
            overflow: hidden;
            border: 1px solid #e9c87a;
        }
        .header {
            background: linear-gradient(135deg, #1b6133, #0f4522);
            padding: 2rem 2.5rem;
            border-bottom: 6px solid #f5c542;
        }
        .header h1 { color: white; font-size: 2.4rem; font-weight: 800; display: flex; align-items: center; flex-wrap: wrap; gap: 18px; }
        .header h1 span { background: #f5c542; color: #1b4d1b; font-size: 1.2rem; font-weight: 700; padding: 0.3rem 1.5rem; border-radius: 60px; }
        .guide-toggle.prominent {
            background: #f5c542; color: #1c542c; font-weight: 800; font-size: 1.3rem;
            padding: 1rem 2rem; cursor: pointer; display: flex; align-items: center; gap: 12px;
            border-bottom: 3px solid #c49f3a; transition: 0.2s; text-transform: uppercase;
        }
        .guide-toggle.prominent:hover { background: #ffde8a; transform: translateY(-2px); box-shadow: 0 6px 0 #9c741c; }
        .guide-panel { background: #fcf9e1; display: none; padding: 2rem; border-bottom: 3px solid #e3bc6a; }
        .guide-panel.show { display: block; animation: slideDown 0.3s ease; }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: translateY(0); } }
        .guide-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.5rem; }
        .guide-step { background: white; border-radius: 28px; padding: 1.3rem; border-left: 8px solid #419c41; box-shadow: 0 5px 0 #cdb066; }
        .guide-step h3 { color: #1f601f; margin-bottom: 0.8rem; }
        .required-badge { color: #d16b4b; font-size: 0.7rem; font-weight: 700; margin-left: 6px; }
        .optional-badge { color: #5e7842; font-size: 0.7rem; font-weight: 700; margin-left: 6px; }
        .new-badge { background: #f0c34a; color: #1f4a1f; font-size: 0.7rem; padding: 2px 8px; border-radius: 30px; margin-left: 8px; }
        .region-bar { background: #2b6a41; padding: 1rem 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 2rem; border-bottom: 2px solid #f2cd6e; }
        .selector-group { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
        .selector-group label { color: #fff5cf; font-weight: 700; }
        .species-select-container { position: relative; min-width: 320px; }
        .species-select-button {
            background: white; border: 3px solid #fdcd5a; border-radius: 60px; padding: 12px 48px 12px 22px;
            font-size: 1rem; font-weight: 600; cursor: pointer; font-style: italic; white-space: nowrap;
            overflow: hidden; text-overflow: ellipsis; position: relative;
        }
        .species-select-button:hover { transform: translateY(-2px); box-shadow: 0 5px 0 #b38f3a; }
        .dropdown-arrow { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); }
        .species-dropdown { position: absolute; top: 100%; left: 0; right: 0; background: white; border: 3px solid #fdcd5a;
            border-radius: 24px; margin-top: 5px; display: none; z-index: 2100; max-height: 380px; overflow-y: auto; box-shadow: 0 15px 30px rgba(0,0,0,0.2); }
        .species-dropdown.show { display: block; }
        .species-search { padding: 12px; border-bottom: 1px solid #ddd; background: white; position: sticky; top: 0; }
        .species-search input { width: 100%; padding: 10px 15px; border-radius: 60px; border: 2px solid #bbcd92; }
        .species-options { max-height: 280px; overflow-y: auto; }
        .species-option { padding: 10px 18px; cursor: pointer; font-style: italic; transition: 0.1s; border-bottom: 1px solid #f0efcf; }
        .species-option:hover { background: #e8f0da; transform: translateX(4px); }
        .species-option.selected { background: #2a6e2a; color: white; }
        .location-options { display: flex; gap: 12px; background: #1f5e38; padding: 0.5rem 1.5rem; border-radius: 60px; align-items: center; flex-wrap: wrap; }
        .location-mode-indicator { background: #4a90e2; padding: 4px 14px; border-radius: 40px; color: white; font-weight: 600; font-size: 0.8rem; }
        .location-mode-toggle { background: #4a90e2; border: none; padding: 6px 15px; border-radius: 30px; color: white; font-weight: bold; cursor: pointer; }
        .map-in-use-badge { background: #d16b4b; padding: 2px 12px; border-radius: 30px; font-size: 0.7rem; opacity: 0; transition: 0.2s; color: white; }
        .map-in-use-badge.show { opacity: 1; }
        .content { padding: 2.2rem; }
        .current-conditions { background: #e2efca; border-radius: 32px; padding: 1rem 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 2rem; align-items: center; }
        .stats-panel { background: #efe1b3; border-radius: 60px; padding: 0.4rem 1rem; display: flex; gap: 1rem; }
        .map-section { background: #e9f2dc; border-radius: 32px; padding: 1.5rem; margin-bottom: 2rem; border: 2px solid #cbb45a; }
        #map { height: 300px; border-radius: 24px; margin-bottom: 1rem; display: none; border: 3px solid #a7bc6f; }
        #map.show { display: block; }
        .coord-display { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; background: #fff6e0; padding: 0.8rem; border-radius: 60px; }
        .split-panel { display: flex; gap: 2rem; flex-wrap: wrap; }
        .data-card { background: #fffff2; border-radius: 32px; padding: 1.8rem; box-shadow: 0 8px 0 #b2bc81; border: 2px solid #d6c87a; flex: 1; }
        .checkbox-cluster { background: #eef5e2; border-radius: 32px; padding: 1rem; display: flex; flex-wrap: wrap; gap: 1rem; margin: 1rem 0; }
        .field-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap: 1rem; }
        .rating-group { display: flex; gap: 1rem; align-items: center; margin: 0.5rem 0; }
        .star-rating { display: flex; gap: 5px; font-size: 1.5rem; cursor: pointer; }
        .star { color: #ccc; transition: 0.1s; }
        .star.active { color: #f5b042; }
        .btn { background: white; border: 3px solid #3a7733; padding: 10px 22px; border-radius: 60px; font-weight: 700; cursor: pointer; transition: 0.2s; }
        .btn-save { background: #c47e2e; color: white; border-color: #f5c542; }
        .btn-csv { background: #3a6b47; color: white; }
        .btn-email { background: #d16b4b; color: white; }
        .action-row { display: flex; gap: 1rem; justify-content: flex-end; margin: 1.5rem 0; flex-wrap: wrap; }
        .records-section { background: #f4efd3; border-radius: 32px; padding: 1.8rem; margin-top: 2rem; }
        .records-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px,1fr)); gap: 1rem; max-height: 450px; overflow-y: auto; }
        .record-card { background: white; border-left: 8px solid #469646; border-radius: 24px; padding: 1rem; cursor: pointer; transition: 0.2s; position: relative; }
        .record-card.selected { border-left-color: #f5b042; background: #fff9e8; }
        .record-select { position: absolute; top: 12px; right: 12px; width: 20px; height: 20px; cursor: pointer; z-index: 5; }
        .import-label { background: #4a6b8a; padding: 8px 18px; border-radius: 40px; color: white; cursor: pointer; display: inline-block; }
        .output-box { background: #1f3b22; color: #e8f0cf; padding: 1.2rem; border-radius: 28px; font-family: monospace; margin-top: 1.5rem; white-space: pre-wrap; }
        .storage-warning { background: #f5a623; border-radius: 30px; padding: 6px 15px; margin: 10px 0; display: none; }
        .manual-temp-card { background: #2d6d8a; border-radius: 60px; padding: 1rem 2rem; display: flex; gap: 2rem; justify-content: center; margin: 1rem 0; color: white; }
        .weather-auto-btn { background: #4a90e2; border: none; padding: 10px 24px; border-radius: 40px; color: white; font-weight: bold; cursor: pointer; }
        .photo-preview { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
        .photo-preview-item { position: relative; width: 80px; }
        .photo-preview-item img { width: 80px; height: 80px; object-fit: cover; border-radius: 12px; border: 2px solid #8ba35e; }
        .photo-remove { position: absolute; top: -5px; right: -5px; background: #d16b4b; color: white; border-radius: 50%; width: 20px; height: 20px; cursor: pointer; }
        @media (max-width: 750px) { .species-select-container { min-width: 220px; } .header h1 { font-size: 1.8rem; } }
    </style>
</head>
<body>
<div class="card">
    <div class="header"><h1>🌱 FUTURE SEEDS PROGRAM <span>v5.0 · SCIENTIFIC EDITION</span></h1></div>
    <div class="guide-toggle prominent" id="guideToggleBtn">📖 USER GUIDE (v5.0)</div>
    <div class="guide-panel" id="guidePanel">
        <div class="guide-grid">
            <div class="guide-step"><h3>🌿 1. Species & Location</h3><ul><li>Click species box → search 80+ species</li><li>Choose Quick Region OR Map Mode (toggle)</li><li>Click map / "My Location" for exact coordinates → weather auto-loads</li></ul></div>
            <div class="guide-step"><h3>📊 2. Abundance & Effort <span class="new-badge">NEW</span></h3><ul><li><strong>Plants assessed:</strong> how many plants you observed</li><li><strong>Survey duration (mins):</strong> time spent sampling</li><li><strong>Flower abundance:</strong> 1 (few) → 5 (mass flowering)</li><li><strong>Pollinator abundance:</strong> per type (0–5 scale)</li></ul></div>
            <div class="guide-step"><h3>🌳 3. Habitat Context <span class="new-badge">NEW</span></h3><ul><li>Canopy cover, soil moisture, recent rainfall (7d)</li><li>Disturbance type (grazing, fire, weeds, roads)</li><li>Helps explain flowering variation</li></ul></div>
            <div class="guide-step"><h3>📸 4. Photo Voucher <span class="optional-badge">optional but valued</span></h3><ul><li>Take or upload photos of plant & flowers</li><li>Critical for species verification by experts</li><li>Images stored in your browser (private)</li></ul></div>
            <div class="guide-step"><h3>⭐ 5. Data Confidence</h3><ul><li>Rate your certainty (1–3 stars)</li><li>Add uncertainty notes if unsure</li></ul></div>
            <div class="guide-step"><h3>💾 6. Save, Export & Share</h3><ul><li><strong>Save Record</strong> → stores in browser</li><li><strong>✅ Export Selected to CSV</strong> → choose records via checkboxes</li><li><strong>📧 Email CSV</strong> → send to researchers</li><li><strong>Import CSV</strong> → reload previous data</li></ul></div>
        </div>
    </div>
    <div class="region-bar">
        <div class="selector-group"><label>🌿 Species:</label><div class="species-select-container"><div class="species-select-button" id="speciesSelectButton"><span id="selectedSpeciesDisplay"><i>Acacia verticillata</i> (Prickly Moses)</span><span class="dropdown-arrow">▼</span></div><select id="speciesSelect" style="display:none;"></select><div class="species-dropdown" id="speciesDropdown"><div class="species-search"><input type="text" id="speciesSearchInput" placeholder="🔍 Search 80+ species..."></div><div class="species-options" id="speciesOptions"></div></div></div></div>
        <div class="location-options"><label>📍 Quick Region:</label><select id="regionSelect"><option value="northWest">🌊 North West</option><option value="north">🌲 North (Launceston)</option><option value="south" selected>🏔️ South (Hobart)</option><option value="westCoast">🌧️ West Coast</option><option value="eastCoast">🏖️ East Coast</option></select><span class="map-in-use-badge" id="mapInUseBadge">📍 Map in use</span><span class="location-mode-indicator" id="locationMode">Quick Region</span><button class="location-mode-toggle" id="toggleLocationMode">🔄 Switch to Map Mode</button></div>
    </div>
    <div class="content">
        <div class="current-conditions"><div class="species-info" id="speciesDisplay">🌼 <i>Acacia verticillata</i> — Prickly Moses</div><div class="stats-panel"><span>📊 Total: <span id="totalRecordsStat">0</span></span><span>🌡️ Avg: <span id="avgTempStat">-</span></span><span>💾 <span id="storageMeter">0 MB</span></span></div><div class="month-indicator" id="currentMonthDisplay">📆 Loading...</div></div>
        <div class="map-section"><div class="map-header"><h3>🗺️ Precise Location <span class="required-badge">map optional</span><span class="info-badge" id="mapModeIndicator">Click map to activate</span></h3><div><button class="map-btn location-btn" id="myLocationBtn">📱 Use My Location</button><button class="map-btn active" id="showMapBtn">Show Map</button><button class="map-btn" id="hideMapBtn">Hide Map</button></div></div><div id="map" class="show"></div><div class="coord-display"><div><label>Latitude:</label><input type="text" id="lat" value="-42.88" readonly></div><div><label>Longitude:</label><input type="text" id="lon" value="147.33" readonly></div><div><label>Source:</label><input type="text" id="coordSource" value="Quick Region (Hobart)" readonly></div></div><div class="location-note" id="locationNote">⚡ Quick Region mode active. Click map or use My Location for precise coordinates.</div></div>
        <div class="split-panel">
            <div><div class="data-card"><h2>🌸 Flowering & Pollinators</h2><div class="field-grid"><div><label>Observer <span class="required-badge">persists</span></label><input type="text" id="observer" placeholder="Your name"></div><div><label>Date <span class="required-badge">required</span></label><input type="date" id="obsDate"></div><div><label>Site name</label><input type="text" id="siteName" placeholder="e.g., Hobart Rivulet"></div></div><div><label>🌼 Flowering stage (check all that apply)</label><div class="checkbox-cluster"><div><input type="checkbox" id="bud"> Bud</div><div><input type="checkbox" id="earlyFlower"> Early flower</div><div><input type="checkbox" id="fullFlower"> Full flower</div><div><input type="checkbox" id="petalFall"> Petal fall</div><div><input type="checkbox" id="seedPod"> Seed pod</div><div><input type="checkbox" id="floweringNone"> 🚫 None observed</div></div></div><div class="field-grid"><div><label>📊 Plants assessed <span class="new-badge">scientific</span></label><input type="number" id="plantsAssessed" min="1" max="1000" placeholder="Number of plants observed"></div><div><label>⏱️ Survey duration (minutes)</label><input type="number" id="surveyDuration" min="1" placeholder="Time spent"></div><div><label>🌸 Flower abundance (1–5)</label><select id="flowerAbundance"><option value="">— scale 1–5 —</option><option value="1">1 (very few flowers)</option><option value="2">2 (few)</option><option value="3">3 (moderate)</option><option value="4">4 (many)</option><option value="5">5 (mass flowering)</option></select></div></div><div><label>🐝 Pollinators observed</label><div class="checkbox-cluster"><div><input type="checkbox" id="honeybee"> Honeybee</div><div><input type="checkbox" id="nativeBee"> Native bee</div><div><input type="checkbox" id="fly"> Fly</div><div><input type="checkbox" id="beetle"> Beetle</div><div><input type="checkbox" id="wasp"> Wasp</div><div><input type="checkbox" id="butterfly"> Butterfly/moth</div><div><input type="checkbox" id="birds"> 🐦 Birds</div><div><input type="checkbox" id="pollinatorsNone"> 🚫 None</div></div><textarea id="otherPollinators" rows="1" placeholder="Other pollinators (bats, lizards, etc.)"></textarea><div class="field-grid"><div><label>🐝 Pollinator abundance (1–5)</label><select id="pollinatorAbundance"><option value="">— abundance —</option><option value="1">1 (rare)</option><option value="2">2 (occasional)</option><option value="3">3 (common)</option><option value="4">4 (abundant)</option><option value="5">5 (very abundant)</option></select></div></div></div><div><label>🌱 Seed maturity</label><select id="seedMaturity"><option value="">— select —</option><option value="green">Green/immature</option><option value="early">Early filling</option><option value="mature">Mature/ready</option><option value="dispersed">Already dispersed</option></select></div></div></div>
            <div><div class="data-card"><h2>🌡️ Weather & Habitat</h2><div class="weather-controls"><button class="weather-auto-btn" id="autoWeatherBtn"><span>🌤️</span> Auto-load Weather</button><span class="weather-source">Open-Meteo (free)</span></div><div class="field-grid"><div><label>Min temp (°C)</label><input type="number" id="actualMinTemp" step="0.1"></div><div><label>Max temp (°C)</label><input type="number" id="actualMaxTemp" step="0.1"></div><div><label>Weather source</label><input type="text" id="bomStation" placeholder="Open-Meteo / BOM"></div></div><div class="manual-temp-card"><div><div class="label">min</div><div class="value" id="displayMin">--°C</div></div><div><div class="label">max</div><div class="value" id="displayMax">--°C</div></div></div><div class="field-grid"><div><label>🌳 Canopy cover</label><select id="canopyCover"><option value="">— select —</option><option value="open">Open (0-30%)</option><option value="partial">Partial (30-70%)</option><option value="dense">Dense (>70%)</option></select></div><div><label>💧 Soil moisture</label><select id="soilMoisture"><option value="">— select —</option><option value="dry">Dry</option><option value="moist">Moist</option><option value="saturated">Saturated</option></select></div><div><label>🌧️ Rainfall last 7 days</label><select id="recentRainfall"><option value="">— select —</option><option value="none">None</option><option value="light">Light (<10mm)</option><option value="moderate">Moderate (10-30mm)</option><option value="heavy">Heavy (>30mm)</option></select></div><div><label>⚠️ Disturbance type</label><select id="disturbance"><option value="">— none / select —</option><option value="grazing">Grazing</option><option value="fire">Recent fire</option><option value="weeds">Weed invasion</option><option value="roadside">Roadside management</option><option value="other">Other</option></select></div></div><div><label>🔥 Fire history</label><select id="fireHistory"><option value="">— select —</option><option value="none">No known fire</option><option value="recent">Recent (<2 yrs)</option><option value="old">Old scar (>5 yrs)</option></select></div><div><label>📝 Site notes</label><textarea id="notes" rows="2" placeholder="Plant health, flowering density, uncertainty..."></textarea></div><div><label>⭐ Data confidence</label><div class="rating-group"><div class="star-rating" id="starRating"><span class="star" data-value="1">☆</span><span class="star" data-value="2">☆</span><span class="star" data-value="3">☆</span></div><span style="font-size:0.8rem;"> (1 = uncertain, 3 = very confident)</span></div><input type="hidden" id="confidenceScore" value=""></div><div><label>📸 Photo voucher (optional)</label><input type="file" id="photoInput" accept="image/*" capture="environment" multiple><div id="photoPreview" class="photo-preview"></div><div class="camera-note" style="font-size:0.75rem; color:#4a6b8a;">📷 Photos stored locally with record</div></div></div></div>
        </div>
        <div id="storageWarning" class="storage-warning"></div><div id="warningsPanel" class="warnings-panel" style="display:none;"></div>
        <div class="action-row"><button class="btn" id="resetBtn">⟲ Reset</button><button class="btn btn-save" id="saveRecordBtn">💾 Save Record</button><button class="btn btn-email" id="emailCsvBtn">📧 Email CSV</button><button class="btn btn-csv" id="exportAllBtn">📄 Export All CSV</button><button class="btn btn-csv" id="exportSelectedBtn">✅ Export Selected CSV</button></div>
        <div class="records-section"><div class="records-header"><h3>📋 Saved Records</h3><div class="record-count" id="recordCount">0 records</div><div class="import-area"><label class="import-label" for="importFile">📂 Import CSV <input type="file" id="importFile" accept=".csv"></label><button class="btn" id="clearAllBtn">🗑️ Clear All</button></div></div><div class="records-grid" id="recordsGrid"></div></div>
        <div class="output-box" id="outputBox">🌿 Future Seeds v5.0 — Scientific edition active. Record abundance, habitat, confidence, and optional photos.</div>
    </div>
</div>
<script>
    (function(){
        const STORAGE_KEY='futureSeedsRecordsV5', OBSERVER_KEY='futureSeedsObserverV5';
        let savedRecords=JSON.parse(localStorage.getItem(STORAGE_KEY))||[];
        let savedObserver=localStorage.getItem(OBSERVER_KEY)||'';
        let selectedRecordIds=new Set(), map, marker, usingMapMode=false, lastWeatherData=null, photoFiles=[];
        const monthNames=['January','February','March','April','May','June','July','August','September','October','November','December'];
        const regionPresets={ northWest:{lat:-41.05,lon:145.9,name:"North West"}, north:{lat:-41.43,lon:147.14,name:"North"}, south:{lat:-42.88,lon:147.33,name:"South"}, westCoast:{lat:-42.15,lon:145.32,name:"West Coast"}, eastCoast:{lat:-41.73,lon:148.25,name:"East Coast"} };
        const fullSpeciesList=[{value:'Acacia verticillata',display:'<i>Acacia verticillata</i> (Prickly Moses)'},{value:'Acacia dealbata',display:'<i>Acacia dealbata</i> (Silver Wattle)'},{value:'Eucalyptus globulus',display:'<i>Eucalyptus globulus</i> (Blue Gum)'},{value:'Banksia marginata',display:'<i>Banksia marginata</i> (Silver Banksia)'},{value:'Telopea truncata',display:'<i>Telopea truncata</i> (Waratah)'},{value:'Leptospermum scoparium',display:'<i>Leptospermum scoparium</i> (Manuka)'},{value:'Eucalyptus obliqua',display:'<i>Eucalyptus obliqua</i>'},{value:'Pomaderris apetala',display:'<i>Pomaderris apetala</i>'},{value:'Olearia phlogopappa',display:'<i>Olearia phlogopappa</i>'},{value:'Melaleuca ericifolia',display:'<i>Melaleuca ericifolia</i>'}];
        for(let i=0;i<80;i++) fullSpeciesList.push({value:`Species_${i}`,display:`<i>Priority species ${i}</i> (Tasmania)`});
        
        let filteredSpecies=[...fullSpeciesList];
        function renderSpeciesOpts(){ const container=document.getElementById('speciesOptions'); const curVal=document.getElementById('speciesSelect').value; container.innerHTML=filteredSpecies.map((sp,idx)=>`<div class="species-option ${curVal===sp.value?'selected':''}" data-value="${sp.value}">${sp.display}</div>`).join(''); document.querySelectorAll('.species-option').forEach(el=>el.addEventListener('click',()=>{ updateSelectedSpecies(el.dataset.value); document.getElementById('speciesDropdown').classList.remove('show'); })); }
        function updateSelectedSpecies(val){ document.getElementById('speciesSelect').value=val; const sp=fullSpeciesList.find(s=>s.value===val); if(sp){ const div=document.createElement('div'); div.innerHTML=sp.display; document.getElementById('selectedSpeciesDisplay').innerText=div.textContent||sp.display; } updateSpeciesInfo(); }
        function filterSpecies(term){ const lower=term.toLowerCase(); filteredSpecies=fullSpeciesList.filter(s=>s.value.toLowerCase().includes(lower)||s.display.toLowerCase().includes(lower)); renderSpeciesOpts(); }
        function initSpeciesSelector(){ fullSpeciesList.forEach(sp=>{ let opt=document.createElement('option'); opt.value=sp.value; opt.innerHTML=sp.display; document.getElementById('speciesSelect').appendChild(opt); }); updateSelectedSpecies('Acacia verticillata'); document.getElementById('speciesSelectButton').addEventListener('click',(e)=>{ e.stopPropagation(); document.getElementById('speciesDropdown').classList.toggle('show'); document.getElementById('speciesSearchInput').focus(); }); document.getElementById('speciesSearchInput').addEventListener('input',e=>filterSpecies(e.target.value)); document.addEventListener('click',()=>document.getElementById('speciesDropdown').classList.remove('show')); renderSpeciesOpts(); }
        function updateSpeciesInfo(){ document.getElementById('speciesDisplay').innerHTML=`🌼 ${document.getElementById('speciesSelect').value}`; }
        function updateMonthDisplay(){ const date=document.getElementById('obsDate').value; let idx=date?new Date(date+'T12:00:00').getMonth():new Date().getMonth(); document.getElementById('currentMonthDisplay').innerHTML=`📆 ${monthNames[idx]}`; }
        function updateTempDisplay(){ document.getElementById('displayMin').innerText=document.getElementById('actualMinTemp').value?`${document.getElementById('actualMinTemp').value}°C`:'--°C'; document.getElementById('displayMax').innerText=document.getElementById('actualMaxTemp').value?`${document.getElementById('actualMaxTemp').value}°C`:'--°C'; }
        async function loadCurrentWeather(){ const lat=document.getElementById('lat').value,lon=document.getElementById('lon').value; try{ const resp=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m&daily=temperature_2m_min,temperature_2m_max&timezone=auto`); const data=await resp.json(); if(data.daily){ document.getElementById('actualMinTemp').value=data.daily.temperature_2m_min[0].toFixed(1); document.getElementById('actualMaxTemp').value=data.daily.temperature_2m_max[0].toFixed(1); updateTempDisplay(); document.getElementById('bomStation').value=`Open-Meteo (auto-loaded)`; } } catch(e){ console.log(e); } }
        function collectRecord(){ let photosBase64=[]; photoFiles.forEach(file=>{ const reader=new FileReader(); reader.readAsDataURL(file); }); return { id:Date.now(), timestamp:new Date().toISOString(), observer:document.getElementById('observer').value.trim(), collectionDate:document.getElementById('obsDate').value, species:document.getElementById('speciesSelect').value, location:{ region:usingMapMode?"Map Selection":regionPresets[document.getElementById('regionSelect').value].name, latitude:parseFloat(document.getElementById('lat').value), longitude:parseFloat(document.getElementById('lon').value), siteName:document.getElementById('siteName').value||null }, phenology:{ flowering:{ bud:document.getElementById('bud').checked, early:document.getElementById('earlyFlower').checked, full:document.getElementById('fullFlower').checked, petalFall:document.getElementById('petalFall').checked, seedPod:document.getElementById('seedPod').checked, none:document.getElementById('floweringNone').checked }, pollinators:{ honeybee:document.getElementById('honeybee').checked, nativeBee:document.getElementById('nativeBee').checked, fly:document.getElementById('fly').checked, beetle:document.getElementById('beetle').checked, wasp:document.getElementById('wasp').checked, butterfly:document.getElementById('butterfly').checked, birds:document.getElementById('birds').checked, other:document.getElementById('otherPollinators').value, none:document.getElementById('pollinatorsNone').checked }, pollinatorAbundance:document.getElementById('pollinatorAbundance').value, flowerAbundance:document.getElementById('flowerAbundance').value, plantsAssessed:document.getElementById('plantsAssessed').value, surveyDuration:document.getElementById('surveyDuration').value, seedMaturity:document.getElementById('seedMaturity').value }, habitat:{ canopyCover:document.getElementById('canopyCover').value, soilMoisture:document.getElementById('soilMoisture').value, recentRainfall:document.getElementById('recentRainfall').value, disturbance:document.getElementById('disturbance').value, fireHistory:document.getElementById('fireHistory').value, notes:document.getElementById('notes').value }, weather:{ minTemp:parseFloat(document.getElementById('actualMinTemp').value)||null, maxTemp:parseFloat(document.getElementById('actualMaxTemp').value)||null, source:document.getElementById('bomStation').value }, confidence:document.getElementById('confidenceScore').value, photos:[] }; }
        function validateForm(){ let errs=[]; if(!document.getElementById('observer').value.trim()) errs.push('Observer name required'); if(!document.getElementById('obsDate').value) errs.push('Date required'); const flowNone=document.getElementById('floweringNone').checked; const flowChecked=['bud','earlyFlower','fullFlower','petalFall','seedPod'].some(id=>document.getElementById(id).checked); if(!flowChecked&&!flowNone) errs.push('Select a flowering stage or "None"'); const pollNone=document.getElementById('pollinatorsNone').checked; const pollChecked=['honeybee','nativeBee','fly','beetle','wasp','butterfly','birds'].some(id=>document.getElementById(id).checked); if(!pollChecked&&!document.getElementById('otherPollinators').value.trim()&&!pollNone) errs.push('Select pollinators or "None"'); const panel=document.getElementById('warningsPanel'); if(errs.length){ panel.style.display='block'; panel.innerHTML='❌ '+errs.join('<br>'); return false; } panel.style.display='none'; return true; }
        function saveRecord(){ if(!validateForm()) return; const rec=collectRecord(); savedRecords.push(rec); localStorage.setItem(STORAGE_KEY,JSON.stringify(savedRecords)); displayRecords(); updateStats(); updateStorageMeter(); document.getElementById('outputBox').innerText=`✅ Saved: ${rec.species} | Plants: ${rec.phenology.plantsAssessed||'?'} | Confidence: ${rec.confidence||'?'}/3`; resetForm(); }
        function displayRecords(){ const grid=document.getElementById('recordsGrid'),countEl=document.getElementById('recordCount'); if(!savedRecords.length){ grid.innerHTML='<div style="grid-column:1/-1; text-align:center;">No records yet.</div>'; countEl.innerText='0 records'; selectedRecordIds.clear(); return; } countEl.innerText=`${savedRecords.length} records`; const sorted=[...savedRecords].reverse(); grid.innerHTML=sorted.map(rec=>`<div class="record-card" data-id="${rec.id}"><input type="checkbox" class="record-select" ${selectedRecordIds.has(rec.id.toString())?'checked':''} onclick="event.stopPropagation(); window.toggleSelection('${rec.id}',this.checked)"><div class="record-date">📅 ${rec.collectionDate}</div><div class="record-species">🌿 ${rec.species.split(' ').slice(0,2).join(' ')}</div><div class="record-location">📍 ${rec.location.region}</div><div class="record-weather">🌡️ ${rec.weather.minTemp||'?'}/${rec.weather.maxTemp||'?'}°C</div><div>⭐ ${rec.confidence||'?'}/3 · 🌸${rec.phenology.flowerAbundance||'?'}</div><div class="record-actions"><button class="record-btn edit" onclick="event.stopPropagation(); editRecordById('${rec.id}')">✏️ Edit</button><button class="record-btn delete" onclick="event.stopPropagation(); deleteRecordById('${rec.id}')">🗑️ Delete</button></div></div>`).join(''); }
        window.toggleSelection=(id,ch)=>{ ch?selectedRecordIds.add(id):selectedRecordIds.delete(id); document.getElementById('outputBox').innerText=`${selectedRecordIds.size} record(s) selected for export.`; };
        window.editRecordById=(id)=>{ const rec=savedRecords.find(r=>r.id==id); if(rec){ alert('Edit mode: delete old record and re-save after changes'); savedRecords=savedRecords.filter(r=>r.id!=id); localStorage.setItem(STORAGE_KEY,JSON.stringify(savedRecords)); displayRecords(); updateStats(); } };
        window.deleteRecordById=(id)=>{ if(confirm('Delete?')){ savedRecords=savedRecords.filter(r=>r.id!=id); selectedRecordIds.delete(id.toString()); localStorage.setItem(STORAGE_KEY,JSON.stringify(savedRecords)); displayRecords(); updateStats(); updateStorageMeter(); } };
        function resetForm(){ document.getElementById('obsDate').value=new Date().toISOString().slice(0,10); document.getElementById('siteName').value=''; document.getElementById('plantsAssessed').value=''; document.getElementById('surveyDuration').value=''; document.getElementById('flowerAbundance').value=''; document.getElementById('pollinatorAbundance').value=''; document.getElementById('canopyCover').value=''; document.getElementById('soilMoisture').value=''; document.getElementById('recentRainfall').value=''; document.getElementById('disturbance').value=''; document.getElementById('confidenceScore').value=''; document.querySelectorAll('.star').forEach(s=>s.classList.remove('active')); if(savedObserver) document.getElementById('observer').value=savedObserver; updateFromRegion(); enableQuickRegionMode(); updateMonthDisplay(); }
        function updateStats(){ const total=savedRecords.length; const temps=savedRecords.filter(r=>r.weather?.minTemp); if(temps.length){ let avgMin=temps.reduce((a,b)=>a+(b.weather.minTemp||0),0)/temps.length; document.getElementById('avgTempStat').innerHTML=`${avgMin.toFixed(1)}°C`; } else document.getElementById('avgTempStat').innerHTML='-'; document.getElementById('totalRecordsStat').innerText=total; }
        function updateStorageMeter(){ const size=new Blob([localStorage.getItem(STORAGE_KEY)||'']).size/(1024*1024); document.getElementById('storageMeter').innerText=`${size.toFixed(2)} MB`; }
        function generateCSV(records){ if(!records.length) return ''; const headers=['ID','Observer','Date','Species','Lat','Lng','Region','MinTemp','MaxTemp','PlantsAssessed','FlowerAbundance','PollinatorAbundance','CanopyCover','SoilMoisture','Disturbance','Confidence','Notes']; const rows=records.map(r=>[r.id,r.observer,r.collectionDate,r.species,r.location.latitude,r.location.longitude,r.location.region,r.weather.minTemp||'',r.weather.maxTemp||'',r.phenology.plantsAssessed||'',r.phenology.flowerAbundance||'',r.phenology.pollinatorAbundance||'',r.habitat.canopyCover||'',r.habitat.soilMoisture||'',r.habitat.disturbance||'',r.confidence||'',r.habitat.notes||'']); return [headers.join(','),...rows.map(row=>row.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(','))].join('\n'); }
        function exportAll(){ const csv=generateCSV(savedRecords); if(csv) downloadCSV(csv,'all_records'); else alert('No records'); }
        function exportSelected(){ const selected=savedRecords.filter(r=>selectedRecordIds.has(r.id.toString())); if(!selected.length){ alert('Select records using checkboxes first.'); return; } downloadCSV(generateCSV(selected),'selected_records'); }
        function downloadCSV(csv,prefix){ const blob=new Blob([csv],{type:'text/csv'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`future_seeds_${prefix}_${new Date().toISOString().slice(0,10)}.csv`; a.click(); URL.revokeObjectURL(a.href); }
        function emailCSV(){ const csv=generateCSV(savedRecords); if(!csv){ alert('No records'); return; } const blob=new Blob([csv],{type:'text/csv'}); const url=URL.createObjectURL(blob); window.location.href=`mailto:?subject=Future%20Seeds%20Data&body=CSV%20export%20from%20Future%20Seeds%20app%3A%20${url}`; setTimeout(()=>URL.revokeObjectURL(url),10000); }
        function initMap(){ map=L.map('map').setView([-42.88,147.33],7); L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(map); marker=L.marker([-42.88,147.33],{draggable:true}).addTo(map); marker.on('dragend',()=>{ const pos=marker.getLatLng(); document.getElementById('lat').value=pos.lat.toFixed(4); document.getElementById('lon').value=pos.lng.toFixed(4); enableMapMode(); loadCurrentWeather(); }); map.on('click',e=>{ marker.setLatLng(e.latlng); document.getElementById('lat').value=e.latlng.lat.toFixed(4); document.getElementById('lon').value=e.latlng.lng.toFixed(4); enableMapMode(); loadCurrentWeather(); }); }
        function enableMapMode(){ usingMapMode=true; document.getElementById('regionSelect').disabled=true; document.getElementById('mapInUseBadge').classList.add('show'); document.getElementById('toggleLocationMode').innerHTML='🔄 Switch to Quick Region'; }
        function enableQuickRegionMode(){ usingMapMode=false; document.getElementById('regionSelect').disabled=false; document.getElementById('mapInUseBadge').classList.remove('show'); document.getElementById('toggleLocationMode').innerHTML='🔄 Switch to Map Mode'; updateFromRegion(); }
        function updateFromRegion(){ if(!usingMapMode){ const reg=document.getElementById('regionSelect').value; const p=regionPresets[reg]; document.getElementById('lat').value=p.lat.toFixed(4); document.getElementById('lon').value=p.lon.toFixed(4); if(marker) marker.setLatLng([p.lat,p.lon]); } }
        function getUserLocation(){ if(navigator.geolocation) navigator.geolocation.getCurrentPosition(pos=>{ marker.setLatLng([pos.coords.latitude,pos.coords.longitude]); document.getElementById('lat').value=pos.coords.latitude.toFixed(4); document.getElementById('lon').value=pos.coords.longitude.toFixed(4); enableMapMode(); loadCurrentWeather(); }); }
        function toggleMap(show){ const mapDiv=document.getElementById('map'); show?mapDiv.classList.add('show'):mapDiv.classList.remove('show'); if(show) setTimeout(()=>map?.invalidateSize(),100); }
        document.getElementById('guideToggleBtn').addEventListener('click',()=>document.getElementById('guidePanel').classList.toggle('show'));
        document.getElementById('toggleLocationMode').addEventListener('click',()=>usingMapMode?enableQuickRegionMode():enableMapMode());
        document.getElementById('myLocationBtn').addEventListener('click',getUserLocation);
        document.getElementById('showMapBtn').addEventListener('click',()=>toggleMap(true));
        document.getElementById('hideMapBtn').addEventListener('click',()=>toggleMap(false));
        document.getElementById('autoWeatherBtn').addEventListener('click',loadCurrentWeather);
        document.getElementById('saveRecordBtn').addEventListener('click',saveRecord);
        document.getElementById('resetBtn').addEventListener('click',resetForm);
        document.getElementById('exportAllBtn').addEventListener('click',exportAll);
        document.getElementById('exportSelectedBtn').addEventListener('click',exportSelected);
        document.getElementById('emailCsvBtn').addEventListener('click',emailCSV);
        document.getElementById('clearAllBtn').addEventListener('click',()=>{ if(confirm('Delete ALL records?')){ savedRecords=[]; selectedRecordIds.clear(); localStorage.setItem(STORAGE_KEY,'[]'); displayRecords(); updateStats(); updateStorageMeter(); } });
        document.getElementById('regionSelect').addEventListener('change',updateFromRegion);
        document.getElementById('obsDate').addEventListener('change',updateMonthDisplay);
        document.getElementById('floweringNone').addEventListener('change',function(){ if(this.checked) ['bud','earlyFlower','fullFlower','petalFall','seedPod'].forEach(id=>document.getElementById(id).checked=false); });
        document.getElementById('pollinatorsNone').addEventListener('change',function(){ if(this.checked) ['honeybee','nativeBee','fly','beetle','wasp','butterfly','birds'].forEach(id=>document.getElementById(id).checked=false); });
        document.getElementById('actualMinTemp').addEventListener('input',updateTempDisplay);
        document.getElementById('actualMaxTemp').addEventListener('input',updateTempDisplay);
        const stars=document.querySelectorAll('.star'); stars.forEach(star=>{ star.addEventListener('click',()=>{ const val=parseInt(star.dataset.value); stars.forEach((s,i)=>{ if(i<val) s.classList.add('active'); else s.classList.remove('active'); }); document.getElementById('confidenceScore').value=val; }); });
        document.getElementById('photoInput').addEventListener('change',e=>{ photoFiles=Array.from(e.target.files); const preview=document.getElementById('photoPreview'); preview.innerHTML=''; photoFiles.forEach(f=>{ const reader=new FileReader(); reader.onload=ev=>{ const div=document.createElement('div'); div.className='photo-preview-item'; div.innerHTML=`<img src="${ev.target.result}" style="width:80px;height:80px;object-fit:cover;"><button class="photo-remove">✖</button>`; div.querySelector('.photo-remove').onclick=()=>div.remove(); preview.appendChild(div); }; reader.readAsDataURL(f); }); });
        initMap(); initSpeciesSelector(); resetForm(); displayRecords(); updateStats(); updateStorageMeter(); if(savedObserver) document.getElementById('observer').value=savedObserver;
    })();
</script>
</body>
</html>
